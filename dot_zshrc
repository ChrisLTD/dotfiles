# nvim as default editor
export EDITOR="nvim"
export VISUAL="nvim"
alias vim=nvim

# Command history
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_ALL_DUPS   # drop older duplicates, keep history unique
setopt HIST_IGNORE_SPACE      # don't record commands prefixed with a space
setopt SHARE_HISTORY          # share history live across running shells

# Initialize zsh's completion system
autoload -Uz compinit && compinit

# Set up fzf key bindings and fuzzy completion
source <(fzf --zsh)
export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"
eval "$(mise activate zsh)"
export GOPRIVATE="github.com/measured-fi"


# claude alternative auth config
alias claude-work='CLAUDE_CONFIG_DIR=~/.claude-business claude'

# zoxide
eval "$(zoxide init zsh)"

# pnpm
alias pn='pnpm'
alias pnx='pnpm dlx'

# ls -> eza
alias ls='eza --group-directories-first --all'
alias ll='eza -lah --git --group-directories-first'

# git-spice (brew installs it as git-spice to avoid clashing with ghostscript)
command -v git-spice >/dev/null && alias gs='git-spice'

# The next line enables shell command completion for gcloud.
if [ -f "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc"; fi

# Worktrunk https://github.com/max-sixty/worktrunk
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi
